# npm run dev:local generates a private server/.env with a random JWT secret.
# For hosted deployments, replace this with your MongoDB Atlas connection URI.
MONGODB_URI=mongodb://127.0.0.1:27017/fitfreak-ai
JWT_SECRET=replace-with-a-long-random-secret
PORT=8000

# Optional: enable AI-generated coach responses. Keep this key on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
